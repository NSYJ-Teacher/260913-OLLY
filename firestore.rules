rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 헬퍼 함수: 이 학급(classroomId)의 담임교사인지 확인
    // 학급 ID = 담임교사의 Firebase Auth UID (교사 1명당 학급 1개, 교사별 완전 분리)
    function isClassroomTeacher(classroomId) {
      return request.auth != null && request.auth.uid == classroomId;
    }

    // 헬퍼 함수: 이 학급의 특정 출석번호 학생 본인 확인
    // 학생 로그인 가상 이메일: student{studentId}_{classroomId}@classroom.local
    // 주의: Firebase Auth는 이메일을 저장/토큰 발급 시 항상 소문자로 정규화합니다.
    // classroomId(Firebase UID)는 대소문자가 섞여 있으므로, 이메일 형태로 비교할 때는
    // 반드시 .lower()로 맞춰야 합니다. (UID 자체를 직접 비교하는 isClassroomTeacher는
    // 이메일이 아니라 UID 값 그대로 비교하므로 영향 없음)
    function isStudentOwner(classroomId, studentId) {
      return request.auth != null &&
        request.auth.token.email == ('student' + string(studentId) + '_' + classroomId.lower() + '@classroom.local');
    }

    match /classrooms/{classroomId} {

      // 학급 설정(학급 이름, 학생 수, 자기평가 오픈 여부 등)
      // - 학생 접속 화면(로그인 전)에서 학급명/학생 수를 표시해야 하므로 읽기는 공개
      //   (개인정보가 아닌 학급 메타데이터만 포함되므로 공개해도 안전함)
      // - 수정은 해당 학급 담임교사만 가능
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isClassroomTeacher(classroomId);
      }

      // 학생 데이터 경로 (classrooms/{classroomId}/students/{studentId}/**)
      match /students/{studentId} {
        // 학생 문서(PIN 등)는 교사만 읽기/쓰기 가능 (학생 본인도 PIN을 직접 변경할 수 없음)
        allow read, write: if isClassroomTeacher(classroomId);

        match /reflections/{docId} {
          allow read: if isClassroomTeacher(classroomId) || isStudentOwner(classroomId, studentId);
          // 학생 본인은 최초 제출(create)만 가능하고, 제출 후에는 교사만 수정/삭제 가능
          // (콘솔 등으로 자신의 제출 내용을 직접 조작할 수 없도록 함)
          // classroomId 필드도 함께 검증해 collectionGroup 쿼리 규칙(아래)이 신뢰할 수 있게 함
          allow create: if (isClassroomTeacher(classroomId) || isStudentOwner(classroomId, studentId))
                         && request.resource.data.studentNum == int(studentId)
                         && request.resource.data.classroomId == classroomId;
          allow update, delete: if isClassroomTeacher(classroomId);
        }

        match /selfAssessments/{docId} {
          allow read: if isClassroomTeacher(classroomId) || isStudentOwner(classroomId, studentId);
          allow create: if (isClassroomTeacher(classroomId) || isStudentOwner(classroomId, studentId))
                         && request.resource.data.studentNum == int(studentId)
                         && request.resource.data.classroomId == classroomId;
          allow update, delete: if isClassroomTeacher(classroomId);
        }
      }
    }

    // 교사 대시보드가 자신의 학급 전체 성찰문/자기평가를 한 번에 조회하는 collectionGroup() 쿼리 전용 규칙.
    // 위 nested match 규칙은 특정 부모 경로를 "직접" 조회할 때만 적용되고 collectionGroup() 쿼리에는
    // 적용되지 않으므로 최상위 와일드카드(path=**) 규칙이 별도로 필요합니다. 와일드카드 경로 세그먼트를
    // 직접 파싱하는 대신(안정성이 낮음), 각 문서에 저장된 classroomId 필드로 본인 학급 여부를 확인합니다.
    match /{path=**}/reflections/{docId} {
      allow read: if request.auth != null && (
        resource.data.classroomId == request.auth.uid ||
        request.auth.token.email == ('student' + string(resource.data.studentNum) + '_' + resource.data.classroomId.lower() + '@classroom.local')
      );
    }

    match /{path=**}/selfAssessments/{docId} {
      allow read: if request.auth != null && (
        resource.data.classroomId == request.auth.uid ||
        request.auth.token.email == ('student' + string(resource.data.studentNum) + '_' + resource.data.classroomId.lower() + '@classroom.local')
      );
    }
  }
}
